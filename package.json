{
  "name": "firefly-ad-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "tsx --env-file-if-exists=.env watch apps/api/src/server.ts",
    "start:api": "tsx --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:cli": "tsx --env-file-if-exists=.env apps/cli/src/main.ts",
    "migrate:workspace-v2": "tsx apps/api/src/legacy-work-migration-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"packages/**/test/*.test.ts\" \"apps/**/test/*.test.ts\"",
    "security:check": "node scripts/security-check.mjs",
    "audit:prod": "npm audit --registry=https://registry.npmjs.org --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm test && npm run security:check"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  }
}

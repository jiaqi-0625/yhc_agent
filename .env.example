# Development only. Keep real credentials in the deployment secret store.
NODE_ENV=development
PORT=3100
HOST=127.0.0.1

# Development/isolated-test default only. Production requires postgres.
PERSISTENCE_BACKEND=local
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Local PostgreSQL may use disable; production should use verify-full.
DATABASE_SSL_MODE=disable

# Optional variables for compose.postgres.yml. Set the password outside this file.
POSTGRES_DB=firefly
POSTGRES_USER=firefly
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Private media object storage. Keep disabled until a private S3-compatible
# bucket and workload identity (preferred) or local-only credentials exist.
OBJECT_STORAGE_BACKEND=disabled
OBJECT_STORAGE_S3_REGION=
OBJECT_STORAGE_S3_BUCKET=
# Optional for S3-compatible providers; AWS S3 normally leaves this blank.
# OBJECT_STORAGE_S3_ENDPOINT=
OBJECT_STORAGE_S3_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SIGNED_GET_TTL_SECONDS=300
# Prefer the cloud workload identity/default SDK credential chain in production.
# OBJECT_STORAGE_S3_ACCESS_KEY_ID=
# OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_S3_SESSION_TOKEN=

# deepseek (default), mock, or volcengine
AGENT_PROVIDER=deepseek
AGENT_MODEL=deepseek-v4-flash
AGENT_BASE_URL=https://api.deepseek.com
AGENT_THINKING_LEVEL=medium

# Prefer the provider-specific key. AGENT_PROVIDER_API_KEY is a local override.
AGENT_PROVIDER_API_KEY=
DEEPSEEK_API_KEY=
ARK_API_KEY=

# Local transcript persistence; business artifacts never use this directory.
LOCAL_AGENT_PERSIST_SESSIONS=true
LOCAL_AGENT_DATA_DIR=.data/sessions
